---
import BaseHead from "./BaseHead.astro";
import { ClientRouter } from "astro:transitions";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

type JsonLd = Record<string, unknown>;

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  publishedDate?: Date;
  updatedDate?: Date;
  structuredData?: JsonLd | JsonLd[];
}

const {
  title = `${SITE_TITLE} — Engineer and Founder`,
  description = SITE_DESCRIPTION,
  image,
  type,
  publishedDate,
  updatedDate,
  structuredData,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      publishedDate={publishedDate}
      updatedDate={updatedDate}
      structuredData={structuredData}
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
      crossorigin="anonymous"
    />
    <ClientRouter />
  </head>
  <body>
    <div id="menu" transition:persist>
      <a class="title" href="/">Waris Reshi</a>
      <ul>
        <li><a href="/about" data-nav="/about">About</a></li>
        <li><a href="/archive" data-nav="/archive">Archive</a></li>
      </ul>
    </div>

    <div id="content">
      <slot />
    </div>

    <script>
      document.addEventListener("keydown", (e) => {
        if (
          e.target instanceof HTMLInputElement ||
          e.target instanceof HTMLTextAreaElement ||
          (e.target as HTMLElement).isContentEditable
        ) return;

        if (e.key === "w") {
          window.location.href = "/";
        }
      });

      const setActive = () => {
        const path = window.location.pathname.replace(/\/$/, "");
        document.querySelectorAll<HTMLAnchorElement>("#menu a[data-nav]").forEach((a) => {
          const target = a.dataset.nav!.replace(/\/$/, "");
          a.classList.toggle("active", path === target || path.startsWith(target + "/"));
        });
      };
      setActive();
      document.addEventListener("astro:page-load", setActive);
    </script>
  </body>
</html>
