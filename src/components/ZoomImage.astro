---
// An optimized inline image that opens a high-resolution copy in the lightbox.
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  class?: string;
}

const { src, alt, width = 1080, class: className } = Astro.props;
const full = await getImage({
  src,
  width: Math.min(src.width, 2560),
  format: "webp",
});
---

<a href={full.src} data-lightbox data-astro-reload>
  <Image src={src} alt={alt} width={width} class={className} />
</a>
