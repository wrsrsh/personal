---
import { Image } from "astro:assets";
import Layout from "../components/Layout.astro";
import efImage from "../assets/about-ef.jpeg";
import { Content } from "../content/about.mdx";
---

<Layout title="About">
    <div class="about-photos">
        <Image
            src={efImage}
            alt="Waris at EF Bangalore"
            width={760}
            loading="eager"
            fetchpriority="high"
        />
    </div>

    <Content />
</Layout>
