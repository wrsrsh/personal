---
import { Image } from "astro:assets";
import Layout from "../components/Layout.astro";
import image1 from "../assets/image-1.webp";

const images = [image1];
---

<Layout title="About">
  <div class="about-photos">
    {images.map((img) => (
      <Image src={img} alt="" width={1000} height={1000} loading="eager" fetchpriority="high" />
    ))}
  </div>

  <p>
  I'm Waris Reshi. engineer and founder. I work at
    <a href="https://asent.app" target="_blank">Asent</a>, building AI infra for
    sales teams. Previously ran a sales agency. I grew up in
    <a href="https://en.wikipedia.org/wiki/Kashmir" target="_blank">Kashmir</a>
    and started building software at age 8.
  </p>

  <p>
    I keep a blog here. You can reach me at
    <a href="mailto:waris@asent.app">waris@asent.app</a>.
  </p>
</Layout>
