---
import Layout from "../components/Layout.astro";
import { quotes } from "../data/quotes";
---

<Layout
  title="Quotes — Waris Reshi"
  description="A collection of quotes I want to keep and come back to."
>
  {quotes.length === 0 ? (
    <p class="quotes-empty">No quotes collected yet.</p>
  ) : (
    <div class="quotes-list">
      {quotes.map((quote) => (
        <figure class="quote">
          <blockquote cite={quote.url}>
            <p>{quote.text}</p>
          </blockquote>
          <figcaption>
            — {quote.author}
            {quote.source && <>, <cite>{quote.url ? <a href={quote.url}>{quote.source}</a> : quote.source}</cite></>}
            {!quote.source && quote.url && <> · <a href={quote.url}>Source</a></>}
          </figcaption>
        </figure>
      ))}
    </div>
  )}
</Layout>

<style>
  .quote {
    margin: 0 0 24px;
    overflow-wrap: anywhere;
  }

  .quote blockquote p {
    margin-bottom: 6px !important;
    white-space: pre-line;
  }

  .quote figcaption {
    font-size: 16.74px;
    color: var(--color-muted);
  }

  .quotes-empty {
    font-size: 16.74px;
  }
</style>
