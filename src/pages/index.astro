---
import Layout from "../components/Layout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => p.data.published !== false)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const renderedPosts = await Promise.all(
  posts.map(async (post) => ({ post, Content: (await render(post)).Content })),
);
---

<Layout>
  {renderedPosts.length > 0 ? (
    <div class="post-feed">
      {renderedPosts.map(({ post, Content }, index) => (
        <section class="feed-post">
          <header class="post-header">
            {index === 0 ? <h1>{post.data.title}</h1> : <h2>{post.data.title}</h2>}
            <p class="meta">
              <FormattedDate date={post.data.pubDate} />
              {post.data.updatedDate && (
                <span> &bull; updated <FormattedDate date={post.data.updatedDate} /></span>
              )}
            </p>
          </header>

          {post.data.heroImage && (
            <div class="imgcap">
              <Image src={post.data.heroImage} alt="" width={1020} loading={index === 0 ? "eager" : "lazy"} />
            </div>
          )}

          <article class="post-content">
            <Content />
          </article>
        </section>
      ))}
    </div>
  ) : (
    <p style="color: var(--color-muted);">No posts yet.</p>
  )}
</Layout>
