---
import Layout from "../components/Layout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => p.data.published !== false)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function preview(body: string | undefined, maxChars = 200): string {
  if (!body) return "";
  const firstPara = body.split(/\n\s*\n/).map(s => s.trim()).find(Boolean) ?? "";
  const stripped = firstPara
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/`([^`]+)`/g, "$1")
    .replace(/[*_>#]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  if (stripped.length <= maxChars) return stripped;
  const cut = stripped.slice(0, maxChars);
  const lastSpace = cut.lastIndexOf(" ");
  return (lastSpace > 0 ? cut.slice(0, lastSpace) : cut) + "…";
}
---

<Layout>
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <h2 class="post-title">
          <a href={`/post/${post.id}/`}>{post.data.title}</a>
        </h2>
        <p class="post-date">
          <FormattedDate date={post.data.pubDate} />
        </p>
        <p class="post-excerpt">{preview(post.body)}</p>
        <p class="post-more">
          <a href={`/post/${post.id}/`}>Read More &rarr;</a>
        </p>
      </li>
    ))}
  </ul>

  {posts.length === 0 && (
    <p style="color: var(--color-muted);">No posts yet.</p>
  )}
</Layout>
